<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <fx>

    <!-- ENGINE -->
    <!-- FRONT ENGINE -->
    <crank>
      <name>engstart1</name>
      <path>BatteryStart.wav</path>
      <property>engines/engine[0]/cranking</property>
      <volume>
        <property>orientation/alpha-deg</property>
        <type>log</type>
        <min>0.5</min>
        <max>1.0</max>
      </volume>
      <volume>
        <factor>2.0</factor>
        <max>2.0</max>
      </volume>
      <position>
        <x> -1.8 </x>
        <y>  0.0 </y>
        <z>  0.0 </z>
      </position>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </crank>

    <crank>
      <name>crank1</name>
      <mode>looped</mode>
      <path>Sounds/cranking.wav</path>
      <condition>
        <property>engines/engine[0]/cranking</property>
        <not><property>engines/engine[0]/running</property></not>
      </condition>
      <volume>
        <property>orientation/alpha-deg</property>
        <type>log</type>
        <min>0.5</min>
        <max>1.0</max>
      </volume>
      <volume>
        <factor>1.2</factor>
        <max>1.0</max>
      </volume>
      <position>
        <x> -1.8 </x>
        <y>  0.0 </y>
        <z>  0.0 </z>
      </position>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </crank>

    <crank>
      <name>cough1</name>
      <path>Sounds/coughing.wav</path>
      <condition>
        <property>engines/engine[0]/cranking</property>
        <not><property>engines/engine[0]/running</property></not>
      </condition>
      <volume>
        <offset>0.9</offset>
      </volume>
      <position>
        <x> -1.8 </x>
        <y>  0.0 </y>
        <z>  0.0 </z>
      </position>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </crank>

    <engine>
      <name>engine-external-1</name>
      <mode>looped</mode>
      <path>Engine_Continental-O200A.wav</path>
      <condition>
        <property>engines/engine[0]/running</property>
        <not><property>/sim/current-view/internal</property></not>
      </condition>
      <volume>
        <property>engines/engine[0]/mp-osi</property>
        <factor>0.00375</factor>
        <min>0.5</min>
        <max>2.0</max>
      </volume>
      <pitch>
        <property>engines/engine[0]/rpm</property>
        <factor>0.00028</factor>
        <min>0.15</min>
        <max>2.0</max>
      </pitch>
      <position>
        <x> -1.8 </x>
        <y>  0.0 </y>
        <z>  0.0 </z>
      </position>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </engine>

    <engine>
      <name>engine-internal-1</name>
      <mode>looped</mode>
      <path>Engine_Continental-O200A-LPF.wav</path>
      <condition>
        <and>
          <property>engines/engine[0]/running</property>
          <property>/sim/current-view/internal</property>
        </and>
      </condition>
      <volume>
        <property>engines/engine[0]/mp-osi</property>
        <factor>0.00375</factor>
        <min>0.5</min>
        <max>2.0</max>
      </volume>
      <pitch>
        <property>engines/engine[0]/rpm</property>
        <factor>0.00028</factor>
        <min>0.15</min>
        <max>2.0</max>
      </pitch>
      <position>
        <x> -1.8 </x>
        <y>  0.0 </y>
        <z>  0.0 </z>
      </position>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </engine>

    <!-- *************************************** -->
    <!-- FLAPS & CONTROLS -->
    <flap>
      <name>flaps</name>
      <mode>in-transit</mode>
      <path>flaps.wav</path>
      <property>surface-positions/flap-pos-norm</property>
      <volume>
        <factor>0.5</factor>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </flap>

    <!-- RUMBLE & SQUEAL -->
    <rumble>
      <name>Rumble</name>
      <mode>looped</mode>
      <path>Sounds/rumble.wav</path>
      <condition>
        <or>
          <property>gear/gear[0]/wow</property>
          <property>gear/gear[1]/wow</property>
          <property>gear/gear[2]/wow</property>
        </or>
      </condition>
      <volume>
        <property>velocities/groundspeed-kt</property>
        <type>log</type>
        <factor>0.35</factor>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </rumble>

    <squeal>
      <name>Squeal</name>
      <path>Squeal.wav</path>
      <condition>
        <or>
          <property>gear/gear[0]/wow</property>
          <property>gear/gear[1]/wow</property>
          <property>gear/gear[2]/wow</property>
        </or>
      </condition>
      <volume>
        <factor>0.8</factor>
      </volume>
      <pitch>
        <property>velocities/groundspeed-kt</property>
        <factor>0.0025</factor>
        <offset>1.2</offset>
      </pitch>
      <position>
        <x> 0.8 </x>
        <y> 0   </y>
        <z>-1.28</z>
      </position>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </squeal>

    <!-- CRASH & ALARMS -->
    <crash>
      <name>Intense ground contact</name>
      <mode>once</mode>
      <path>Sounds/crash.wav</path>
      <property>sim/crashed</property>
      <volume>
        <factor>1</factor>
      </volume>
      <pitch>
        <factor>0.1</factor>
      </pitch>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </crash>

    <stall>
      <name>stall</name>
      <mode>looped</mode>
      <type>avionics</type>
      <path>stall.wav</path>
      <condition>
        <and>
          <property>controls/electric/battery-switch</property>
          <less-than>
            <property>velocities/airspeed-kt</property>
            <value>52</value>
          </less-than>
          <not>
            <property>controls/gear/gear-down</property>
          </not>
          <not>
            <property>gear/gear[0]/wow</property>
            <property>gear/gear[1]/wow</property>
            <property>gear/gear[2]/wow</property>
          </not>
        </and>
      </condition>
      <volume>
        <factor>0.7</factor>
      </volume>
    </stall>

    <aoa-warn>
        <name>aoa-warn</name>
        <mode>looped</mode>
        <type>avionics</type>
        <path>warn.wav</path>
        <condition>
        <property>controls/electric/battery-switch</property>
			  <greater-than>
				  <property>orientation/alpha-deg</property>
				  <value>10.0</value>
			  </greater-than>
        <not>
          <property>gear/gear[0]/wow</property>
          <property>gear/gear[1]/wow</property>
          <property>gear/gear[2]/wow</property>
        </not>
        </condition>
        <volume>
          <factor>0.7</factor>
        </volume>
    </aoa-warn>

    <rita-aoa-warn>
        <name>rita aoa warning</name>
        <mode>looped</mode>
        <type>avionics</type>
        <path>rita_aoa.wav</path>
        <condition>
        <property>controls/electric/battery-switch</property>
			  <greater-than>
				  <property>orientation/alpha-deg</property>
				  <value>10.0</value>
			  </greater-than>
        <not>
          <property>gear/gear[0]/wow</property>
          <property>gear/gear[1]/wow</property>
          <property>gear/gear[2]/wow</property>
        </not>
        </condition>
        <volume>
          <factor>0.8</factor>
        </volume>
    </rita-aoa-warn>

    <gear-warn>
      <name>gear warning</name>
      <mode>looped</mode>
      <path>Sounds/gear-hrn.wav</path>
      <condition>
       <and>
         <less-than>
           <property>/velocities/airspeed-kt</property>
           <value>85</value>
         </less-than>
         <less-than>
           <property>/position/altitude-agl-ft</property>
           <value>500</value>
         </less-than>
         <not>
           <property>/controls/gear/gear-down</property>
         </not>
       </and>
      </condition>
      <volume>
        <factor>0.6</factor>
      </volume>
      <position>
        <x> -2.00 </x>
        <y>  0.40 </y>
        <z>  1.40 </z>
      </position>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </gear-warn>

    <rita-gear-warn>
      <name>rita gear warning</name>
      <mode>looped</mode>
      <path>rita_geardown.wav</path>
      <condition>
       <and>
         <less-than>
           <property>/velocities/airspeed-kt</property>
           <value>85</value>
         </less-than>
         <less-than>
           <property>/position/altitude-agl-ft</property>
           <value>500</value>
         </less-than>
         <not>
           <property>/controls/gear/gear-down</property>
         </not>
       </and>
      </condition>
      <volume>
        <factor>0.8</factor>
      </volume>
      <position>
        <x> -2.00 </x>
        <y>  0.40 </y>
        <z>  1.40 </z>
      </position>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </rita-gear-warn>

    <rita-overspeed>
            <name>rita_overspeed_warning</name>
            <mode>looped</mode>
            <path>rita_vne.wav</path>
            <condition>
              <greater-than>
                  <property>/velocities/airspeed-kt</property>
                  <value>240</value>
              </greater-than>
            </condition>
            <volume>
                <factor>0.8</factor>
            </volume>
    </rita-overspeed>

    <gear>
      <name>gear</name>
      <mode>in-transit</mode>
      <path>Sounds/gear.wav</path>
      <property>gear/gear[0]/position-norm</property>
      <pitch>
        <internal>dt_play</internal>
        <offset>1.0</offset>
        <factor>-0.001</factor>
      </pitch>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
      <volume>
          <factor>0.4</factor>
      </volume>
    </gear>

    <gear>
      <name>gear-lock</name>
      <path>Sounds/gear-lck.wav</path>
      <condition>
        <equals>
          <property>gear/gear[0]/position-norm</property>
          <value>0</value>
        </equals>
      </condition>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </gear>

    <wind>
      <name>wind</name>
      <mode>looped</mode>
      <path>Sounds/wind.wav</path>
      <property>velocities/airspeed-kt</property>
      <volume>
        <property>position/altitude-ft</property>
        <factor>-0.000015</factor>
        <offset>0.4</offset>
        <min>0.1</min>
        <max>0.4</max>
      </volume>
      <volume>
        <property>velocities/airspeed-kt</property>
        <factor>0.0007</factor>
        <min>0.03</min>
        <max>0.12</max>
      </volume>
      <pitch>
        <property>velocities/airspeed-kt</property>
        <factor>0.01</factor>
        <offset>1.25</offset>
      </pitch>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </wind>

<!-- CANOPY -->
    <door>
      <name>Canopy Open</name>
      <path>CanopyOpen.wav</path>
      <condition>
        <greater-than>
          <!-- <property>sim/model/door-positions/crew/position-norm</property> -->
          <property>sim/multiplay/generic/float[0]</property>
          <value>0.1</value>
        </greater-than>
      </condition>
      <volume>
        <factor>0.8</factor>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </door>

    <door>
      <name>Canopy Close</name>
      <path>CanopyClosed.wav</path>
      <condition>
        <equals>
          <!-- <property>sim/model/door-positions/crew/position-norm</property> -->
          <property>sim/multiplay/generic/float[0]</property>
          <value>0</value>
        </equals>
      </condition>
      <volume>
        <factor>1</factor>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </door>

    <stop>
      <name>stop</name>
      <mode>once</mode>
      <path>shutdown.wav</path>
      <condition>
        <and>
          <not>
            <property>/engines/engine/running</property>
          </not>
          <greater-than>
          			<property>/engines/engine/rpm</property>
          			<value>0</value>
        	</greater-than>
        </and>
      </condition> 
      <volume>
        <offset>0.45</offset>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>500</max-dist>
    </stop>

    <!-- Switch -->

    <click>
      <name>StarterKey ON</name>
      <path>Button.wav</path>
      <condition>
        <property>/controls/switches/starterkey-insert</property>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>StarterKey OFF</name>
      <path>Button.wav</path>
      <condition>
        <not>
          <property>/controls/switches/starterkey-insert</property>
        </not>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>Magnetos ON</name>
      <path>Button.wav</path>
      <condition>
        <equals>
          <property>controls/engines/engine[0]/magnetos</property>
          <value>3</value>
        </equals>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>Magnetos OFF</name>
      <path>Button.wav</path>
      <condition>
        <equals>
          <property>controls/engines/engine[0]/magnetos</property>
          <value>0</value>
        </equals>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>Master ON</name>
      <path>Button.wav</path>
      <condition>
        <property>/controls/electric/battery-switch</property>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>Master OFF</name>
      <path>Button.wav</path>
      <condition>
        <not>
          <property>/controls/electric/battery-switch</property>
        </not>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>Generator ON</name>
      <path>Button.wav</path>
      <condition>
        <property>controls/electric/engine[0]/generator</property>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>Generator OFF</name>
      <path>Button.wav</path>
      <condition>
        <not>
          <property>controls/electric/engine[0]/generator</property>
        </not>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>FuelPump ON</name>
      <path>Button.wav</path>
      <condition>
        <property>controls/engines/engine[0]/fuel-pump</property>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>FuelPump OFF</name>
      <path>Button.wav</path>
      <condition>
        <not>
          <property>controls/engines/engine[0]/fuel-pump</property>
        </not>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>FuelTank1 ON</name>
      <path>Button.wav</path>
      <condition>
        <property>consumables/fuel/tank[0]/selected</property>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>FuelTank1 OFF</name>
      <path>Button.wav</path>
      <condition>
        <not>
          <property>consumables/fuel/tank[0]/selected</property>
        </not>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>Ignition ON</name>
      <path>Button.wav</path>
      <condition>
        <property>controls/engines/engine[0]/ignition</property>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>Ignition OFF</name>
      <path>Button.wav</path>
      <condition>
        <not>
          <property>controls/engines/engine[0]/ignition</property>
        </not>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>Pitot heat ON</name>
      <path>Button.wav</path>
      <condition>
        <property>controls/anti-ice/pitot-heat</property>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>Pitot heat OFF</name>
      <path>Button.wav</path>
      <condition>
        <not>
          <property>controls/anti-ice/pitot-heat</property>
        </not>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>Instrument light ON</name>
      <path>Button.wav</path>
      <condition>
        <property>controls/lighting/instrument-lights</property>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <click>
      <name>Instrument light OFF</name>
      <path>Button.wav</path>
      <condition>
        <not>
          <property>controls/lighting/instrument-lights</property>
        </not>
      </condition>
      <volume>
        <factor>1.0</factor>
      </volume>
    </click>

    <!--Avionics-->

    <avionics>
      <name>mfi-hum</name>
      <mode>looped</mode>
      <path>avionics.wav</path>
      <type>avionics</type>
      <condition>
       <and>
          <property>/sim/current-view/internal</property>
         <or>
           <property>/controls/instrumentation/mfis/mfi[1]/booting</property>
           <property>/controls/instrumentation/mfis/mfi[2]/booting</property>
           <property>/controls/instrumentation/mfis/mfi[3]/booting</property> 
           <property>/controls/instrumentation/mfis/mfi[4]/booting</property>
           <equals>
             <property>/controls/instrumentation/mfis/mfi[1]/page</property>
             <value>7</value>
           </equals>
         </or>
        </and>
      </condition>
      <volume>
        <factor>0.3</factor>
      </volume>
    </avionics>

    <rain>
      <name>rain</name>
      <mode>looped</mode>
      <path>rain.wav</path>
      <condition>
        <greater-than>
          <property>environment/metar/rain-norm</property>
          <value>0.2</value>
        </greater-than>
      </condition>
      <volume>
        <property>environment/metar/rain-norm</property>
        <factor>1.00</factor>
        <offset>0.00</offset>
        <min>0.4</min>
        <max>0.9</max>
      </volume>
      <pitch>
        <property>velocities/airspeed-kt</property>
        <factor>0.001</factor>
        <offset>1.0</offset>
      </pitch>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </rain>

  <!-- ========================================================== -->
  <!-- NPP ZVEZDA SKS-94 EJECTION SYSTEM AUDIO TRIGGERS          -->
  <!-- ========================================================== -->

  <!-- Rear Seat Rocket Canopy Blast (Fires if Copilot is Present) -->
  <copilot-eject-sound>
    <name>copilot-canopy-rocket</name>
    <mode>once</mode>
    <path>eject.wav</path>
    <condition>
      <property>/controls/seat/eject/copilot-ejected</property>
    </condition>
    <volume>
      <factor>0.85</factor>
    </volume>
  </copilot-eject-sound>

  <!-- Front Seat Rocket Blast (Fires for Main Pilot Execution) -->
  <pilot-eject-sound>
    <name>pilot-canopy-rocket</name>
    <mode>once</mode>
    <path>eject.wav</path>
    <condition>
      <property>/controls/seat/eject/pilot-ejected</property>
    </condition>
    <volume>
      <factor>0.85</factor>
    </volume>
  </pilot-eject-sound>

  <!-- Main Parachute Canopy Inflation Sequence -->
  <parachute-deploy-sound>
    <name>parachute-inflation</name>
    <mode>once</mode>
    <path>chute.wav</path>
    <condition>
      <and>
        <property>/controls/seat/eject/ejected</property>
        <greater-than>
          <property>/controls/seat/eject/chute-norm</property>
          <value>0.25</value>
        </greater-than>
      </and>
    </condition>
    <volume>
      <factor>0.70</factor>
    </volume>
  </parachute-deploy-sound>

  </fx>

</PropertyList>
