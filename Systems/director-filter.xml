<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>

  <!-- STEP 1: Compute Stable Angular Heading Error Relative to Selected OBS Course -->
  <!-- Uses trigonometric normalization to eliminate 0/360 wrap-around vulnerabilities -->
  <filter>
    <name>FD Course Heading Error Normalizer</name>
    <type>gain</type>
    <gain>1.0</gain>
    <input>
      <expression>
        <prod>
          <atan2>
            <sin>
              <prod>
                <difference>
                  <property>/instrumentation/nav/radials/selected-deg</property> <!-- Fixed Selected Radial Course -->
                  <property>/orientation/heading-deg</property> <!-- Actual Aircraft Nose Heading -->
                </difference>
                <value>0.0174532925</value> <!-- Degrees to Radians -->
              </prod>
            </sin>
            <cos>
              <prod>
                <difference>
                  <property>/instrumentation/nav/radials/selected-deg</property>
                  <property>/orientation/heading-deg</property>
                </difference>
                <value>0.0174532925</value> <!-- Degrees to Radians -->
              </prod>
            </cos>
          </atan2>
          <value>57.2957795</value> <!-- Radians back to Degrees -->
        </prod>
      </expression>
    </input>
    <output>/instrumentation/flight-director/course-heading-error-deg</output>
  </filter>

  <!-- STEP 2: Combine Cross-Track Deviation and Heading Error into Commanded Bank -->
  <!-- Direct geometric mixing avoids integration saturation wind-up issues entirely -->
  <filter>
    <name>FD Target Bank Command</name>
    <type>gain</type>
    <gain>1.0</gain>
    <input>
      <expression>
        <sum>
          <prod>
            <property>/instrumentation/nav/heading-needle-deflection</property>
            <value>2.5</value> <!-- Cross-track displacement gain factor -->
          </prod>
          <prod>
            <property>/instrumentation/flight-director/course-heading-error-deg</property>
            <value>0.5</value> <!-- Intercept angle scaling factor -->
          </prod>
        </sum>
      </expression>
    </input>
    <output>/instrumentation/flight-director/commanded-roll-deg</output>
    <min>-25.0</min> <!-- Rigidly locks maximum bank command limits to safe tolerances -->
    <max>25.0</max>
  </filter>

  <!-- STEP 3: Final Cross-Comparison to Generate Follow-The-Needle Deflection Value -->
  <filter>
    <name>FD Final Core Error Engine</name>
    <type>gain</type>
    <gain>1.0</gain>
    <input>/instrumentation/flight-director/commanded-roll-deg</input>
    <reference>/orientation/roll-deg</reference> <!-- Compares target bank angle directly to active roll state -->
    <output>/instrumentation/flight-director/computed-roll-error</output>
  </filter>

</PropertyList>
