<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <sim               include="views.xml">

    <fuel-fraction>1</fuel-fraction>

    <startup>
      <splash-texture>Aircraft/Yak-152/yak-152-splash.png</splash-texture>
    </startup>

    <sound>
      <path          archive="y">Aircraft/Yak-152/Sounds/yak-152-sound.xml</path>
    </sound>

    <model>
      <path          archive="y">Aircraft/Yak-152/Models/yak-152.xml</path>
      <livery>
        <file        type="string"/>
        <specular>
          <red       type="float"> 0.03 </red>
          <green     type="float"> 0.03 </green>
          <blue      type="float"> 0.03 </blue>
        </specular>
      </livery>
      <show-copilot  type="bool"/>
    </model>

    <systems         include="rules.xml"/>

    <instrumentation include="initialisation.xml"/>

    <multiplay>
      <chat_display>1</chat_display>
      <generic>
        <!-- -->
        <int    n="0"  type="int"/>
        <int    n="1"  type="int"/>
        <int    n="2"  type="int"/>
        <int    n="3"  type="int"/>
        <int    n="4"  type="int"/>
        <int    n="5"  type="int"/>
        <!-- -->
        <bool   n="0"  alias="/sim/model/show-copilot"/>
        <bool   n="1"  alias="/sim/crashed"/>
        <bool   n="2"  alias="/sim/rendering/hdr/hdr-enabled"/>
        <bool   n="3"  alias="/gear/gear[0]/wow"/>
        <bool   n="4"  alias="/gear/gear[1]/wow"/>
        <bool   n="5"  alias="/gear/gear[2]/wow"/>
        <!-- -->
        <bool   n="6"  alias="/controls/engines/engine[0]/cutoff"/>
        <bool   n="7"  alias="/controls/engines/engine[0]/starter"/>
        <!-- Engines -->
        <bool   n="9"  alias="/engines/engine[0]/cranking"/>

        <!-- Lights -->
        <bool   n="11" alias="/controls/lighting/beacon"/>
        <bool   n="12" alias="/sim/model/lights/beacon/state"/>
        <bool   n="13" alias="/controls/lighting/strobe"/>
        <bool   n="14" alias="/sim/model/lights/sbc1/state"/>
        <bool   n="15" alias="/controls/lighting/nav-lights"/>
        <bool   n="16" alias="/controls/lighting/landing-lights"/>
        <!-- -->
        <bool   n="17"  alias="/sim/model/smoke"/>
        <bool   n="18" alias="/controls/lighting/taxi-light"/>

        <!-- Doors -->
        <float  n="0"  alias="/sim/model/door-positions/crew/position-norm"/>
        <float  n="1"  alias="/sim/model/door-positions/passenger/position-norm"/>
        <!-- -->
        <float  n="2"  alias="/position/gear-agl-m">0</float>
        <float  n="3"  alias="/position/altitude-ft">0</float>
        <!-- Engines -->
        <float  n="4"  alias="/engines/engine[0]/rpm"/>
        <!-- -->
        <float  n="5" alias="/controls/engines/engine[0]/noze-flaps-norm"/>
        <float  n="6" alias="/controls/engines/engine[0]/cowl-flaps-norm"/>
        <!-- -->
        <float  n="10" alias="/gear/gear[0]/caster-angle-deg"/>
        <!-- -->
        <float  n="11" alias="/controls/engines/engine[0]/throttle"/>
        <!-- -->
        <float  n="12" alias="/gear/gear[0]/rollspeed-ms"/>
        <float  n="13" alias="/gear/gear[1]/rollspeed-ms"/>
        <float  n="14" alias="/gear/gear[2]/rollspeed-ms"/>
        <!-- -->
        <float  n="15" alias="/gear/gear[0]/compression-norm"/>
        <float  n="16" alias="/gear/gear[1]/compression-norm"/>
        <float  n="17" alias="/gear/gear[2]/compression-norm"/>
        <!-- -->
        <string n="1"  alias="/sim/model/livery/texture"/>
        <!-- For Bombable -->
        <int    n="10" type="int" alias="/controls/armament/trigger">0</int>
        <string n="9"  type="string"/>
      </generic>
    </multiplay>

    <help            include="help.xml"/>

    <checklists include="yak-152-checklists.xml"/>

    <flaps           include="flaps.xml"/>

    <menubar         include="../Dialogs/yak-152-menu.xml"/>

    <aircraft-data   include="aircraft-data.xml"/>

  </sim>

  <input             include="yak-152-keyboard.xml"/>

  <engines           include="engines.xml"/>

  <consumables       include="consumables.xml"/>

  <controls          include="controls.xml"/>

  <instrumentation   include="instrumentation.xml">
    <gsdi>
      <serviceable   type="bool">true</serviceable>
      <enabled       type="bool">true</enabled>
    </gsdi>
  </instrumentation>

  <nasal>
    <doors>
      <file>Aircraft/Yak-152/Nasal/doors.nas</file>
    </doors>
    <yak152>
      <file>Aircraft/Yak-152/Nasal/hdr.nas</file>
      <file>Aircraft/Yak-152/Nasal/liveries.nas</file>
      <file>Aircraft/Yak-152/Nasal/light.nas</file>
      <file>Aircraft/Yak-152/Nasal/fluids.nas</file>
      <file>Aircraft/Yak-152/Nasal/yak152.nas</file>
      <file>Aircraft/Yak-152/Nasal/convert.nas</file>
      <file>Aircraft/Yak-152/Nasal/Electrical.nas</file>
      <file>Aircraft/Yak-152/Nasal/mfi.nas</file>
      <file>Aircraft/Yak-152/Nasal/map.nas</file>
      <file>Aircraft/Yak-152/Nasal/nd.nas</file>
      <file>Aircraft/Yak-152/Nasal/dlg.nas</file>
    </yak152>
    <radiocfg>
      <file>Aircraft/Yak-152/Nasal/radiocfg.nas</file>
    </radiocfg>
    <fadec>
      <file>Aircraft/Yak-152/Nasal/fadecadv.nas</file>
    </fadec>
    <autostart>
      <file>Aircraft/Yak-152/Nasal/autostart.nas</file>
    </autostart>

    aircraft.data.add(

      "instrumentation/nav[0]/power-btn",
      "instrumentation/nav[0]/audio-btn",
      "instrumentation/nav[0]/frequencies/selected-mhz",
      "instrumentation/nav[0]/frequencies/standby-mhz",
      "instrumentation/nav[0]/to-flag",
      "instrumentation/nav[0]/from-flag",
      "instrumentation/nav[0]/radials/selected-deg",
      "instrumentation/nav[0]/gs-needle-deflection",
      "instrumentation/nav[0]/heading-needle-deflection",
      "instrumentation/nav[0]/in-range",
      "instrumentation/nav[0]/ident",
      "instrumentation/comm[0]/volume",
      "instrumentation/comm[0]/frequencies/selected-mhz",
      "instrumentation/comm[0]/frequencies/standby-mhz",
      "instrumentation/comm[0]/test-btn",

      "instrumentation/nav[1]/power-btn",
      "instrumentation/nav[1]/audio-btn",
      "instrumentation/nav[1]/frequencies/selected-mhz",
      "instrumentation/nav[1]/frequencies/standby-mhz",
      "instrumentation/nav[1]/to-flag",
      "instrumentation/nav[1]/from-flag",
      "instrumentation/nav[1]/radials/selected-deg",
      "instrumentation/nav[1]/gs-needle-deflection",
      "instrumentation/nav[1]/heading-needle-deflection",
      "instrumentation/nav[1]/in-range",
      "instrumentation/nav[1]/ident",
      "instrumentation/comm[1]/volume",
      "instrumentation/comm[1]/frequencies/selected-mhz",
      "instrumentation/comm[1]/frequencies/standby-mhz",
      "instrumentation/comm[1]/test-btn",

    );

  </nasal>

</PropertyList>
