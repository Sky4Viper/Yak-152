<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <lighting>
    <instrument-lights  type="bool">false</instrument-lights>
    <nav-lights         type="bool">false</nav-lights>
    <taxi-light         type="bool">false</taxi-light>
    <beacon             type="bool">false</beacon>
    <strobe             type="bool">false</strobe>
    <landing-lights     type="bool">false</landing-lights>
    <luminosite-lights  type="float">1</luminosite-lights>
    <floods-lights      type="float">0.5</floods-lights>
    <switch-position    type="int">0</switch-position>
  </lighting>

  <electric>
    <battery-switch     type="bool">false</battery-switch>
    <avionics-switch    type="bool">false</avionics-switch>
    <engines>
      <engine           n="0">
        <fuel-pump      type="bool">false</fuel-pump>
      </engine>
    </engines>
  </electric>

  <instrumentation>
    <mfis>
        <live-map type="bool">true</live-map>
        
        <!-- Left MFI pilot (Cockpit 1) -->
        <mfi n="1">
            <page type="int">0</page>
            <subpage type="int">0</subpage>
            <brightness-norm type="double">0.0</brightness-norm> <!-- changed double for smoother knobs -->
        </mfi>
        
        <!-- Right MFI pilot (Cockpit 1) -->
        <mfi n="2">
            <page type="int">0</page>
            <subpage type="int">0</subpage>
            <brightness-norm type="double">0.0</brightness-norm>
        </mfi>
        
        <!-- Left MFI co-pilot(Cockpit 2) -->
        <mfi n="3">
            <page type="int">0</page>
            <subpage type="int">0</subpage>
            <brightness-norm type="double">0.0</brightness-norm>
        </mfi>
        
        <!-- Right MFI co-pilot(Cockpit 2) -->
        <mfi n="4">
            <page type="int">0</page>
            <subpage type="int">0</subpage>
            <brightness-norm type="double">0.0</brightness-norm>
        </mfi>
    </mfis>
  </instrumentation>

  <engines>
    <engine            n="0">
      <boost           type="double">0</boost>
      <magnetos>0</magnetos>
      <noze-flaps-norm type="float">1</noze-flaps-norm>
      <cowl-flaps-norm type="float">1</cowl-flaps-norm>
      <propeller-pitch type="float">0</propeller-pitch>
    </engine>
  </engines>

  <gear>
    <brake-parking     type="bool">true</brake-parking>
    <tailwheel-lock    type="bool">true</tailwheel-lock>
  </gear>

  <flight>
    <rudder-trim       type="double">  0.0000 </rudder-trim>
    <aileron-trim      type="double"> 0.0017 </aileron-trim>
    <elevator-trim     type="double"> 0.0020 </elevator-trim>
  </flight>

  <seat>
    <eject n="0">
      <ejected     type="bool">false</ejected>
      <eject-norm  type="double"> 0.0</eject-norm>
      <chute-norm  type="double"> 0.0</chute-norm>
      <chute-inflate-norm  type="double"> 0.0</chute-inflate-norm>
      <view-type type="int">0</view-type>
    </eject>
    <eject n="1">
      <ejected     type="bool">false</ejected>
      <eject-norm  type="double"> 0.0</eject-norm>
      <chute-norm  type="double"> 0.0</chute-norm>
      <chute-inflate-norm  type="double"> 0.0</chute-inflate-norm>
    </eject>
  </seat>

</PropertyList>
