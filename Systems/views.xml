<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <chase-distance-m              type="double" archive="y">-15</chase-distance-m>

  <view                          n="100">
    <name                        type="string">Tail Camera View</name>
    <type>lookfrom</type>
    <internal                    archive="y">true</internal>
    <config>
      <from-model                type="bool">true</from-model>
      <from-model-idx            type="int">0</from-model-idx>
      <ground-level-nearplane-m  type="double">0.01</ground-level-nearplane-m>
      <x-offset-m                archive="y"> 0.00000 </x-offset-m> <!--Right-->
      <y-offset-m                archive="y"> 1.64414 </y-offset-m> <!--Up-->
      <z-offset-m                archive="y"> 3.27567 </z-offset-m> <!--Back-->
      <pitch-offset-deg          type="double">-15</pitch-offset-deg>
      <default-field-of-view-deg type="double">90</default-field-of-view-deg>

    </config>
  </view>

  <view                          n="101">
    <name                        type="string">Instructor Seat View</name>
    <internal                    archive="y">true</internal>
    <type>lookfrom</type>
    <config>
      <from-model                type="bool">true</from-model>
      <ground-level-nearplane-m  type="double">0.5</ground-level-nearplane-m>
      <x-offset-m                archive="y"> 0.00000 </x-offset-m> <!-- Right -->
      <y-offset-m                archive="y"> 0.46035 </y-offset-m> <!-- Up    -->
      <z-offset-m                archive="y"> 0.89845 </z-offset-m> <!-- Back  -->
      <pitch-offset-deg          type="double">-8</pitch-offset-deg>
      <default-field-of-view-deg type="double">79</default-field-of-view-deg>
      <dynamic-view              type="bool">true</dynamic-view>
    </config>
  </view>


  <view n="102">
    <name type="string">Ejection View</name>
    <type>lookfrom</type>
    <internal archive="y">true</internal>
    <config>
      <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
      <ground-level-nearplane-m type="double">0.01</ground-level-nearplane-m>
      <x-offset-m archive="y"> 0.000 </x-offset-m>
      <y-offset-m archive="y"> 0.1 </y-offset-m>
      <z-offset-m archive="y">-1.06 </z-offset-m>
      <pitch-offset-deg type="double">58</pitch-offset-deg>
      <heading-offset-deg>180</heading-offset-deg>
      <default-field-of-view-deg type="double">114</default-field-of-view-deg>
    </config>
  </view>

  <!-- VIEW 103: FIRST-PERSON VIEW (LOOKFROM HIS EYES) -->
  <view n="103">

    <name type="string">Ejected Pilot First Person View</name>
    <type>lookfrom</type>
    <config>
      <from-model type="bool">false</from-model>
      <from-model-idx type="int">0</from-model-idx>
      
      <eye-lat-deg-path>/ai/models/ballistic[0]/position/latitude-deg</eye-lat-deg-path>
      <eye-lon-deg-path>/ai/models/ballistic[0]/position/longitude-deg</eye-lon-deg-path>
      <eye-alt-ft-path>/ai/models/ballistic[0]/position/altitude-ft</eye-alt-ft-path>
      
      <eye-heading-deg-path>/ai/models/ballistic[0]/orientation/hdg-deg</eye-heading-deg-path>
      <eye-pitch-deg-path>/ai/models/ballistic[0]/orientation/pitch-deg</eye-pitch-deg-path>
      <eye-roll-deg-path>/ai/models/ballistic[0]/orientation/roll-deg</eye-roll-deg-path>
      
      <ground-level-nearplane-m type="double">0.01</ground-level-nearplane-m>
      
      <x-offset-m type="double">0.01</x-offset-m>  
      <y-offset-m type="double">-0.44</y-offset-m> <!-- Forward -->
      <z-offset-m type="double">0.96</z-offset-m> <!--UP  -->

      <pitch-offset-deg>-70</pitch-offset-deg>
      <heading-offset-deg>180</heading-offset-deg> <!-- 180-degree camera rotation so it faces forward along the pilot's sight line -->
      
      <default-field-of-view-deg type="double">95</default-field-of-view-deg> 
    </config>
  </view>

  <!-- VIEW 104: CINEMATIC VIEW (LOOKAT TRACKING CAMERA 22.4 METERS AWAY) -->
  <view n="104">

    <name type="string">Ejected Pilot Cinematic Tracker</name>
    <type>lookat</type> 
    <config>
      <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
      
      <target-lat-deg-path>/ai/models/ballistic[0]/position/latitude-deg</target-lat-deg-path>
      <target-lon-deg-path>/ai/models/ballistic[0]/position/longitude-deg</target-lon-deg-path>
      <target-alt-ft-path>/ai/models/ballistic[0]/position/altitude-ft</target-alt-ft-path>
      <target-heading-deg-path>/ai/models/ballistic[0]/orientation/hdg-deg</target-heading-deg-path>
      
      <at-model type="bool">true</at-model>
      <at-model-idx type="int">0</at-model-idx>
      <ground-level-nearplane-m type="double">0.5</ground-level-nearplane-m>
      
      <x-offset-m type="double">18.0</x-offset-m>  
      <y-offset-m type="double">6.0</y-offset-m>   
      <z-offset-m type="double">-12.0</z-offset-m> 
      <pitch-offset-deg>-15</pitch-offset-deg>

      <heading-offset-deg>135</heading-offset-deg>
    </config>
  </view>

  <view                           n="0">
    <name                        type="string">Cockpit View</name>
    <internal                     archive="y">true</internal>
    <config>
       <x-offset-m                archive="y">  0.00000 </x-offset-m> <!-- Right -->
       <y-offset-m                archive="y">  0.41689 </y-offset-m> <!-- Up    -->
       <z-offset-m                archive="y"> -0.4653 </z-offset-m> <!-- Back  -->
       <pitch-offset-deg          type="double">-4</pitch-offset-deg>
       <default-field-of-view-deg type="double">93</default-field-of-view-deg>
    </config>
  </view>

  <view                           n="1">
    <config>
      <target-z-offset-m          archive="y" type="double"> 0 </target-z-offset-m>

    </config>
  </view>

  <view                           n="2">
    <config>
      <target-z-offset-m          archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <view                           n="3">
    <config>
      <target-z-offset-m          archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <view                           n="4">
    <config>
      <target-z-offset-m          archive="y" type="double"> 0 </target-z-offset-m>
    </config>

  </view>

  <view                           n="5">
    <config>
      <target-z-offset-m          archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <view                           n="6">
    <config>
      <target-z-offset-m          archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

</PropertyList>


