  <!-- Switches -->

  <!-- UNIFIED 3-POSITION TAXI-LANDING LIGHTS SWITCH ROTATION -->
  <animation>
    <type>rotate</type>
    <object-name>lp_switch.001</object-name>
    <property>/controls/lighting/switch-position</property>
    <interpolation>
      <entry><ind>0</ind><dep>  0</dep></entry> <!-- State 0: Center Neutral (OFF) -->
      <entry><ind>1</ind><dep>-26</dep></entry> <!-- State 1: Toggled Up (TAXI) -->
      <entry><ind>2</ind><dep> 26</dep></entry> <!-- State 2: Toggled Down (LANDING) -->
    </interpolation>
