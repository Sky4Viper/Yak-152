  <object-name>rp_knob.002</object-name>
  <object-name>rp2_knob.002</object-name>
    <increase>
      <binding>
        <command>property-adjust</command>
        <property>controls/lighting/instruments-norm</property>
            <step>0.1</step>
            <min>0.0</min>
            <max>0.9</max>
            <wrap>false</wrap>
      </binding>
      <!-- <binding>
            <command>nasal</command>
            <script>switchclicksound.click("adf-dial")</script>
      </binding> -->
      </increase>
      <decrease>
        <binding>
          <command>property-adjust</command>
          <property>controls/lighting/instruments-norm</property>
            <step>-0.1</step>
            <min>0.0</min>
            <max>0.9</max>
            <wrap>false</wrap>
        </binding>
        <!-- <binding>
                <command>nasal</command>
                <script>switchclicksound.click("adf-dial")</script>
        </binding> -->
        </decrease>
        <hovered>
          <binding>
                <command>set-tooltip</command>
                <tooltip-id>instruments-lighting-adj</tooltip-id>
                <label>Instruments lights</label>
          </binding>
        </hovered>
  </animation>

</PropertyList>
