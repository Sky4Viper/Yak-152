<?xml version="1.0"?>

<PropertyList>

 <path>gmeter.ac</path>

 <animation>
  <type>material</type>
  <object-name>UAP-7.needle1</object-name>
  <!-- <object-name>UAP-7.needle2</object-name> -->
  <object-name>UAP-7.needle3</object-name>
  <object-name>uap-face</object-name>
 <emission>
          <factor-prop>controls/lighting/instruments-norm</factor-prop>
          <red>   0.50 </red>
          <green> 0.40 </green>
          <blue>  0.30 </blue>
     </emission>
     <condition>
          <property>controls/electric/battery-switch</property>
     </condition>
 </animation>

 <effect>
    <inherits-from>../../../../Effects/Glass/glass</inherits-from>
    <object-name>uap-glass</object-name>
  </effect>

 <animation>
  <type>rotate</type>
  <object-name>UAP-7.needle1</object-name>
  <property>accelerations/pilot-g</property>
  <interpolation>
   <entry><ind>-4</ind><dep>90</dep></entry>
   <entry><ind> 0</ind><dep>  0.0</dep></entry>
   <entry><ind>10</ind><dep>225</dep></entry>
  </interpolation>
  <axis>
   <x>-1</x>
   <y> 0</y>
   <z> 0</z>
  </axis>
 </animation>

