 <animation>
  <type>rotate</type>
  <object-name>UAP-7.needle3</object-name>
  <property>yak152/instrumentation/UAP/pilot-g-max</property>
  <interpolation>
   <entry><ind> 0</ind><dep>  0.0</dep></entry>
   <entry><ind>10</ind><dep>225</dep></entry>
  </interpolation>
  <axis>
   <x>1</x>
   <y>0</y>
   <z>0</z>
  </axis>
 </animation>

 <animation>
  <type>pick</type>
  <object-name>UAP-7.cz1</object-name>
  <visible>false</visible>
  <action>
   <button>0</button>
   <repeatable>false</repeatable>
   <binding>
    <command>property-assign</command>
    <property>yak152/instrumentation/UAP/pilot-g-max</property>
    <value>1.0</value>
   </binding>
  </action>
 </animation>

</PropertyList>
