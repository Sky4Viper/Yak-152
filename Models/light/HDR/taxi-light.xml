<?xml version="1.0" encoding="ISO-8859-1"?>

 <PropertyList>

  <light>
    <name>lightconelight</name>
    <type>spot</type>
    <direction>
      <lookat-x-m> -0.5 </lookat-x-m>
      <lookat-y-m>  0.0 </lookat-y-m>
      <lookat-z-m>  0.0 </lookat-z-m>
    </direction>
    <color>
      <r> 1 </r>
      <g> 1 </g>
      <b> 1 </b>
    </color>
    <!-- Dimmed from 2.5 to 1.2 to eliminate overexposure hotspots -->
    <intensity> 1.2 </intensity>
    <spot-exponent> 4 </spot-exponent>
    <spot-cutoff> 26.5 </spot-cutoff>
    <range-m> 225.0 </range-m>
  </light>


  <animation>
    <type>noshadow</type>
    <object-name>lightconelight</object-name>
  </animation>

   <animation>
    <type>select</type>
    <object-name>lightconelight</object-name>
    <nopreview/>
    <condition>
      <!-- <property>controls/lighting/taxi-lights</property> -->
      <property>sim/multiplay/generic/bool[18]</property>
    </condition>
  </animation>

</PropertyList>
