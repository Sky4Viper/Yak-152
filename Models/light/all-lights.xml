<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <model>
    <name>Beacon</name>
    <path>beacon.xml</path>
    <offsets>
      <x-m> 1.45053 </x-m>
      <y-m> 0.00000 </y-m>
      <z-m> 0.56593 </z-m>
    </offsets>
  </model>

  <model>
    <name>RedLight</name>
    <path>RedLight.xml</path>
    <offsets>
      <x-m> -0.515695 </x-m>
      <y-m> -4.4228 </y-m>
      <z-m> -0.328405 </z-m>
      <heading-deg> 15.0 </heading-deg>
    </offsets>
  </model>

  <model>
    <name>StrobeLightL</name>
    <path>StrobeLight.xml</path>
    <offsets>
      <x-m> -0.450728 </x-m>
      <y-m> -4.40522 </y-m>
      <z-m> -0.328405 </z-m>
      <heading-deg> -15.0 </heading-deg>
    </offsets>
  </model>

  <model>
    <name>GreenLight</name>
    <path>GreenLight.xml</path>
    <offsets>
      <x-m> -0.515695 </x-m>
      <y-m>  4.4228 </y-m>
      <z-m> -0.328405 </z-m>
      <heading-deg> -15.0 </heading-deg>
    </offsets>
  </model>

  <model>
    <name>StrobeLightR</name>
    <path>StrobeLight.xml</path>
    <offsets>
      <x-m> -0.450728 </x-m>
      <y-m>  4.40522 </y-m>
      <z-m> -0.328405 </z-m>
      <heading-deg> 15.0 </heading-deg>
    </offsets>
  </model>

  <model>
    <name>LightTail</name>
    <path>WhiteLight.xml</path>
    <offsets>
      <x-m>  2.39619 </x-m>
      <y-m>  0.00000 </y-m>
      <z-m> -0.348806 </z-m>
    </offsets>
  </model>

  <model>
    <name>TaxiLightGear</name>
    <path>taxi-light.xml</path>
    <condition>
      <equals>
        <property>gear/gear[0]/position-norm</property>
        <value>1</value>
      </equals>
    </condition>
    <offsets>
      <x-m> -2.05393 </x-m>
      <y-m> -0.069038 </y-m>
      <z-m> -1.15167 </z-m>
    </offsets>
  </model>

  <!-- Landing light cone Left -->
  <model>
    <name>WingLandingLightLeft</name>
    <path>light-cone.xml</path>
    <offsets>
      <x-m> -1.13737 </x-m>
      <y-m> -2.70242 </y-m>
      <z-m> -0.46452 </z-m>
    </offsets>
  </model>

  <!-- test -->
