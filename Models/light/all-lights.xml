    </offsets>
  </model>

  <model>
    <path>HDR/lightpanel.xml</path>
    <offsets>
      <x-m> -0.136 </x-m>
      <y-m>  0.000 </y-m>
      <z-m>  0.506 </z-m>
    </offsets>
  </model> -->

  <!-- -->

  <animation>
    <type>select</type>
    <object-name>TaxiLightGear</object-name>
    <object-name>WingLandingLightLeft</object-name>
    <object-name>LightTail</object-name>
    <object-name>StrobeLightL</object-name>
    <object-name>StrobeLightR</object-name>
    <object-name>GreenLight</object-name>
    <object-name>RedLight</object-name>
    <object-name>Beacon</object-name>
    <condition>
      <or>
        <property>controls/electric/battery-switch</property>
        <and>
          <property>controls/electric/engine/generator</property>
          <property>engines/engine[0]/running</property>
        </and>
      </or>
    </condition>
  </animation>

</PropertyList>
