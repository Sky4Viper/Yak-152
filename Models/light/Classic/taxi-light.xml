<?xml version="1.0" encoding="ISO-8859-1"?>

 <PropertyList>

   <path>light-cone.ac</path>
   <nopreview/>

   <animation>
     <object-name>Cone</object-name>
     <object-name>Cone-texture</object-name>
     <object-name>Light</object-name>
   </animation>

   <animation>
     <type>noshadow</type>
     <object-name>Cone</object-name>
     <object-name>Cone-texture</object-name>
     <object-name>Light</object-name>
   </animation>

   <effect>
     <inherits-from>Effects/model-transparent</inherits-from>
     <object-name>Cone</object-name>
     <object-name>Cone-texture</object-name>
     <object-name>Light</object-name>
   </effect>

   <effect>
     <inherits-from>Effects/light-cone</inherits-from>
     <object-name>Cone</object-name>
     <object-name>Cone-texture</object-name>
   </effect>

   <animation>
     <type>material</type>
     <object-name>Light</object-name>
     <emission>
       <red>   2 </red>
       <green> 2 </green>
       <blue>  2 </blue>
     </emission>
   </animation>

   <animation>
     <type>scale</type>
     <object-name>Cone</object-name>
     <object-name>Cone-texture</object-name>
     <object-name>Light</object-name>
     <x-offset>0.5</x-offset>
     <y-offset>0.3</y-offset>
     <z-offset>0.3</z-offset>
   </animation>

   <animation>
    <type>select</type>
    <object-name>Cone</object-name>
    <object-name>Cone-texture</object-name>
    <object-name>Light</object-name>
    <condition>
      <!-- <property>controls/lighting/taxi-light</property> -->
      <property>sim/multiplay/generic/bool[18]</property>
    </condition>
  </animation>

</PropertyList>
