<?xml version="1.0" encoding="ISO-8859-1"?>

 <PropertyList>

   <path>petitcone.ac</path>
   <nopreview/>

   <animation>
     <object-name>PetitCone</object-name>
   </animation>

   <animation>
     <type>noshadow</type>
     <object-name>PetitCone</object-name>
   </animation>

   <effect>
     <inherits-from>Effects/model-transparent</inherits-from>
     <object-name>PetitCone</object-name>
   </effect>

   <effect>
     <inherits-from>Effects/light-cone</inherits-from>
     <object-name>PetitCone</object-name>
   </effect>

   <animation>
     <type>material</type>
     <object-name>PetitCone</object-name>
     <emission>
       <red>   2 </red>
       <green> 2 </green>
       <blue>  2 </blue>
     </emission>
   </animation>

  <light>
    <name>ProceduralLandingLight</name>
    <type>spot</type>
    <direction>
      <lookat-x-m> -10.0 </lookat-x-m> 
      <lookat-y-m>   0.0 </lookat-y-m> 
      <lookat-z-m>  -0.9 </lookat-z-m> 
    </direction>
    <ambient>
      <!-- Dimmed down from 0.95 -->
      <r> 0.65 </r>
      <g> 0.65 </g>
      <b> 0.65 </b>
      <a> 1.00 </a>
    </ambient>
    <diffuse>
      <!-- Dimmed down from 0.95 -->
      <r> 0.65 </r>
      <g> 0.65 </g>
      <b> 0.65 </b>
      <a> 1.00 </a>
    </diffuse>
    <specular>
      <!-- Dimmed down from 0.95 to soften ground reflections -->
      <r> 0.65 </r>
      <g> 0.65 </g>
      <b> 0.65 </b>
      <a> 1.00 </a>
    </specular>
    <attenuation>
      <c> 1.0000 </c>
      <l> 0.0140 </l> 
      <q> 0.0004 </q>
    </attenuation>
    <spot-exponent>5</spot-exponent>
    <spot-cutoff>88.33</spot-cutoff> 
    <range-m>150</range-m> 
    <debug-color>
      <r> 1 </r>
      <g> 1 </g>
      <b> 1 </b>
      <a> 1 </a>
    </debug-color>
  </light>

  <animation>
    <type>noshadow</type>
    <object-name>PetitCone</object-name>
    <object-name>ProceduralLandingLight</object-name>
  </animation>

   <animation>
     <type>scale</type>
     <object-name>PetitCone</object-name>
     <x-offset>0.5</x-offset>
     <y-offset>0.3</y-offset>
     <z-offset>0.3</z-offset>
   </animation>

   <animation>
    <type>select</type>
     <object-name>PetitCone</object-name>
    <object-name>ProceduralLandingLight</object-name>
    <nopreview/>
    <condition>
      <!-- <property>controls/lighting/taxi-lights</property> -->
      <property>sim/multiplay/generic/bool[18]</property>
    </condition>
  </animation>

</PropertyList>
