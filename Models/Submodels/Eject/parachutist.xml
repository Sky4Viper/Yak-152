<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>
    <path>parachutist.ac</path>

    <offsets>
        <x-m>0.94</x-m> <!-- Up -->
        <y-m>0.0</y-m> <!-- Left -->
        <z-m>0.08</z-m> <!-- Back -->
        <pitch-deg> 90 </pitch-deg>
    </offsets>

    <effect>
        <object-name>DragChute</object-name>
        <inherits-from>Effects/chute</inherits-from>
        <parameters>
            <chute_force>
                <use>/controls/seat/eject/eject-norm</use>
            </chute_force>
            <chute_projection_z>10.35</chute_projection_z>
            <chute_fold>0.0</chute_fold>
            <chute_bend>0.0</chute_bend>
        </parameters>
    </effect>

    <!-- ========================================================== -->
    <!-- MATERIAL ANIMATIONS: WHITE & ORANGE CANOPY WITH BLACK ROPES-->
    <!-- ========================================================== -->

    <!-- Orange Canopy Panels -->
    <!-- <animation>
        <type>material</type>
        <object-name>DragChute</object-name>
        <diffuse>
            <r>1.000</r>
            <g>0.450</g>
            <b>0.000</b>
        </diffuse>
        <ambient>
            <r>0.700</r>
            <g>0.280</g>
            <b>0.000</b>
        </ambient>
        <specular>
            <r>0.000</r>
            <g>0.000</g>
            <b>0.000</b>
        </specular>
    </animation> -->

    <model>
     <name>EPilot</name>
     <path>Aircraft/Yak-152/Models/Pilot/pilotlowpoly.xml</path>
       <offsets>
         <x-m>-0.027042</x-m>
         <y-m> 0.03</y-m>
         <z-m>-0.581401</z-m>
         <heading-deg> -180 </heading-deg>
         <pitch-deg> -20.86 </pitch-deg>
        </offsets>
    </model>

    <animation>
		<type>scale</type>
		<object-name>DragChute</object-name>
		<property>/controls/seat/eject/chute-norm</property>
		<x-min>0</x-min>
		<y-min>0</y-min>
		<z-min>0</z-min>
		<x-max>1</x-max>
		<y-max>1</y-max>
		<z-max>1</z-max>
		<x-factor>1</x-factor>
		<y-factor>1</y-factor>
        <z-factor>4</z-factor>
	</animation>

    <!-- ========================================================== -->
    <!-- 1. AXIS 1: NATURAL SPIN AND FLUTTER (VERTICAL Z-AXIS)      -->
    <!-- ========================================================== -->
    <animation>
        <type>rotate</type>
        <object-name>DragChute</object-name>
        <object-name>EPilot</object-name>
        <condition>
            <property>/controls/seat/eject/ejected</property>
        </condition>
        <expression>
            <sum>
                <!-- Main continuous spin linked to wind speed (Dropped to a tiny fraction) -->
                <product>
                    <property>/sim/time/elapsed-sec</property>
                    <property>/environment/wind-speed-kt</property>
                    <value>0.08</value> <!-- Dropped from 1.0. At 100kt, this equals a relaxed 8° per second spin -->
                </product>
                <!-- Minor heading wobble (Frequency lowered to a slow swing, angle restricted) -->
                <product>
                    <sin>
                        <product>
                            <property>/sim/time/elapsed-sec</property>
                            <value>2.5</value> <!-- Dropped from 5.5. A very slow, natural twist back and forth -->
                        </product>
                    </sin>
                    <value>5.0</value> <!-- Dropped from 5.0. Restricts heading twist to just 3 degrees -->
                </product>
            </sum>
        </expression>
        <center>
            <x-m>0.0</x-m>
            <y-m>0.0</y-m>
            <z-m>6.5</z-m>
        </center>
        <axis>
            <x>0</x>
            <y>0</y>
            <z>1</z>
        </axis>
    </animation>

    <!-- ========================================================== -->
    <!-- 2. AXIS 2: PHYSICAL PENDULUM SWAY (LATERAL Y-AXIS TILT)     -->
    <!-- ========================================================== -->
    <animation>
        <type>rotate</type>
        <object-name>DragChute</object-name>
        <object-name>EPilot</object-name>
        <condition>
            <property>/controls/seat/eject/ejected</property>
        </condition>
        <expression>
            <!-- Heavy, slow pendulum swing (Frequency slowed down further, tilt softened) -->
            <product>
                <sin>
                    <product>
                        <property>/sim/time/elapsed-sec</property>
                        <value>1.2</value> <!-- Dropped from 2.1. Gives a much heavier, slower pendulum period -->
                    </product>
                </sin>
                <value>4.0</value> <!-- Dropped from 6.5. Maximum tilt restricted to a subtle 4 degrees -->
            </product>
        </expression>
        <center>
            <x-m>0.0</x-m>
            <y-m>0.0</y-m>
            <z-m>4.5</z-m> 
        </center>
        <axis>
            <x>0</x>
            <y>1</y> 
            <z>0</z>
        </axis>
    </animation>




</PropertyList>
