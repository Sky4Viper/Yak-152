<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>
    <path>parachutist.ac</path>

    <offsets>
        <x-m>0.94</x-m> <!-- Up -->
        <y-m>0.0</y-m> <!-- Left -->
        <z-m>0.08</z-m> <!-- Back -->
        <pitch-deg> 90 </pitch-deg>
    </offsets>

    <effect>
        <object-name>DragChute</object-name>
        <inherits-from>Effects/chute</inherits-from>
        <parameters>
            <chute_force>
                <use>/controls/seat/eject/eject-norm</use>
            </chute_force>
            <chute_projection_z>10.35</chute_projection_z>
            <chute_fold>0.0</chute_fold>
            <chute_bend>0.0</chute_bend>
        </parameters>
    </effect>

    <model>
     <name>EPilot</name>
     <path>Aircraft/Yak-152/Models/Pilot/pilotlowpoly.xml</path>
       <offsets>
         <x-m>-0.027042</x-m>
         <y-m> 0.03</y-m>
         <z-m>-0.581401</z-m>
         <heading-deg> -180 </heading-deg>
         <pitch-deg> -20.86 </pitch-deg>
        </offsets>
    </model>

    <animation>
        <type>scale</type>
        <object-name>DragChute</object-name>
        <property>/controls/seat/eject/chute-norm</property>
        <z-factor>1.0</z-factor>
    </animation>

    <animation>
        <type>scale</type>
        <object-name>DragChute</object-name>
        <property>/controls/seat/eject/chute-inflate-norm</property>
        <x-min>0.3</x-min>
        <y-min>0.3</y-min>
        <z-min>1.0</z-min>
        <x-factor>1.0</x-factor>
        <y-factor>1.0</y-factor>
    </animation>

    <animation>
      <type>rotate</type>
      <object-name>DragChute</object-name>
      <object-name>EPilot</object-name>
      <property>/controls/seat/eject/chute-norm</property>
      <interpolation>
        <entry><ind>0</ind><dep>190</dep></entry>
        <entry><ind>1</ind><dep>0</dep></entry>
      </interpolation>
      <axis>
        <x> 0</x>
        <y>-1</y>
        <z> 0</z>
      </axis>
    </animation>

</PropertyList>
