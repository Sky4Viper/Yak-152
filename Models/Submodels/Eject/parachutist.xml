<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>
    <path>parachutist.ac</path>

    <offsets>
        <x-m>0.94</x-m> <!-- Up -->
        <y-m>0.0</y-m> <!-- Left -->
        <z-m>0.08</z-m> <!-- Back -->
        <pitch-deg> 90 </pitch-deg>
    </offsets>

    <effect>
        <object-name>DragChute</object-name>
        <inherits-from>Effects/chute</inherits-from>
        <parameters>
            <chute_force>
                <use>/controls/seat/eject/eject-norm</use>
            </chute_force>
            <chute_projection_z>10.35</chute_projection_z>
            <chute_fold>0.0</chute_fold>
            <chute_bend>0.0</chute_bend>
        </parameters>
    </effect>

    <model>
     <name>EPilot</name>
     <path>Aircraft/Yak-152/Models/Pilot/pilotlowpoly.xml</path>
       <offsets>
         <x-m>-0.027042</x-m>
         <y-m> 0.03</y-m>
         <z-m>-0.581401</z-m>
         <heading-deg> -180 </heading-deg>
         <pitch-deg> -20.86 </pitch-deg>
        </offsets>
    </model>

    <!-- UNIFIED TWO-STAGE NON-FIGHTING SCALE ANIMATION -->
    <animation>
        <type>scale</type>
        <object-name>DragChute</object-name>
        
        <!-- The master property acts as the execution trigger for the block -->
        <property>/controls/seat/eject/chute-norm</property>
        <x-min>0</x-min>
        <y-min>0</y-min>
        <z-min>0</z-min>
        <x-max>1</x-max>
        <y-max>1</y-max>
        <z-max>1</z-max>

        <!-- STAGE 1: LONGITUDINAL EXTENSION (Z Axis Only) -->
        <!-- Drives length automatically off chute-norm, multiplied by our static factor -->
        <z-factor-prop>/controls/seat/eject/chute-norm</z-factor-prop>
        <z-factor>4.0</z-factor>

        <!-- STAGE 2: CANOPY INFLATION (X & Y Width Axes Only) -->
        <!-- Binds the width properties to a separate interpolation map -->
        <!-- This forces X and Y to look AT chute-inflate-norm instead of the master property -->
        <x-factor-prop>/controls/seat/eject/chute-inflate-norm</x-factor-prop>
        <interpolation n="0">
            <!-- Holds the width compressed at a narrow 8% profile when inflate-norm is 0 -->
            <entry><ind>0.0</ind><dep>0.08</dep></entry>
            <!-- Blooms out to 100% full volume when your Nasal script timer fires -->
            <entry><ind>1.0</ind><dep>1.00</dep></entry>
        </interpolation>
        <x-factor>1.0</x-factor>

        <y-factor-prop>/controls/seat/eject/chute-inflate-norm</y-factor-prop>
        <interpolation n="1">
            <entry><ind>0.0</ind><dep>0.08</dep></entry>
            <entry><ind>1.0</ind><dep>1.00</dep></entry>
        </interpolation>
        <y-factor>1.0</y-factor>

        <!-- Pivot center point coordinates where the lines meet the seat pack -->
        <offset-m>
            <x-m>0.0</x-m>
            <y-m>0.0</y-m>
            <z-m>0.5</z-m>
        </offset-m>
    </animation>







</PropertyList>
