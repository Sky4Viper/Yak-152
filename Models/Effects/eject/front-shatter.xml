<?xml version="1.0" encoding="ISO-8859-1"?>
<PropertyList>

  <particlesystem>
    <name>front-canopy-shatter</name>
    
    <offsets>
      <x-m>0.0</x-m>
      <y-m>0.0</y-m>
      <z-m>0.0</z-m>
      <roll-deg>0</roll-deg>
      <pitch-deg>0</pitch-deg>
      <heading-deg>0</heading-deg>
    </offsets>
    
    <texture>Aircraft/Yak-152/Models/Effects/canopyshatter/noise3.png</texture>
    
    <emissive>false</emissive>
    <lighting>false</lighting>
    <align>billboard</align>
    <attach>world</attach>
    
    <!-- CRITICAL FIX: Direct property injection wakes up the particle node at the moment of ejection -->
    <condition>
      <property>/controls/seat/eject/pilot-ejected</property>
    </condition>
    
    <placer>
      <type>point</type>
    </placer>
    
    <shooter>
      <theta-min-deg>50</theta-min-deg>
      <theta-max-deg>120</theta-max-deg>
      <phi-min-deg>0</phi-min-deg>
      <phi-max-deg>360</phi-max-deg>
      
      <speed-mps>
        <value>35</value>
        <spread>15</spread>
      </speed-mps>
    </shooter>
    
    <counter>
      <type>once</type>
      <number>150</number>
    </counter>
    
    <particle>
      <start>
        <color>
          <red><value>0.85</value></red>
          <green><value>0.95</value></green>
          <blue><value>1.00</value></blue>
          <alpha><value>0.9</value></alpha>
        </color>
        <size>
          <value>0.03</value>
        </size>
      </start>
      <end>
        <color>
          <red><value>0.85</value></red>
          <green><value>0.95</value></green>
          <blue><value>1.00</value></blue>
          <alpha><value>0.0</value></alpha>
        </color>
        <size>
          <value>0.05</value>
        </size>
      </end>
      <life-sec>
        <value>0.6</value>
      </life-sec>
      <mass-kg>0.02</mass-kg>
      <radius-m>0.03</radius-m>
    </particle>
    
    <program>
      <fluid>air</fluid>
      <gravity>true</gravity>
      <wind>true</wind>
    </program>
  </particlesystem>

</PropertyList>

