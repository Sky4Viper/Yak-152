<?xml version="1.0" encoding="ISO-8859-1"?>
<PropertyList>

  <particlesystem>
    <name>front-smoke</name>
    
    <offsets>
      <x-m>0.0</x-m>
      <y-m>0.0</y-m>
      <z-m>0.0</z-m>
      <roll-deg>0</roll-deg>
      <pitch-deg>0</pitch-deg>
      <heading-deg>0</heading-deg>
    </offsets>
    
    <texture>smoke.png</texture>
    
    <emissive>false</emissive>
    <lighting>false</lighting>
    <align>billboard</align>
    <attach>world</attach>
    
    <placer>
      <type>point</type>
    </placer>
    
    <shooter>
      <theta-min-deg>170</theta-min-deg>
      <theta-max-deg>190</theta-max-deg>
      <phi-min-deg>-5.0</phi-min-deg>
      <phi-max-deg>5.0</phi-max-deg>
      
      <speed-mps>
        <value>35</value>
        <spread>5.0</spread>
      </speed-mps>
      
      <rotation-speed>
        <x-min-deg-sec>10</x-min-deg-sec>
        <y-min-deg-sec>10</y-min-deg-sec>
        <z-min-deg-sec>10</z-min-deg-sec>
        <x-max-deg-sec>90</x-max-deg-sec>
        <y-max-deg-sec>90</y-max-deg-sec>
        <z-max-deg-sec>90</z-max-deg-sec>
      </rotation-speed>
    </shooter>
    
    <!-- PROPERTY DYNAMIC COUNTER DRIVER: Avoids parent select-culling glitches -->
    <counter>
      <particles-per-sec>
        <property>/controls/seat/eject/smoke-rate-front</property>
        <factor>140</factor>
      </particles-per-sec>
    </counter>
    
    <particle>
      <start>
        <color>
          <red><value>0.68</value></red>
          <green><value>0.66</value></green>
          <blue><value>0.70</value></blue>
          <alpha><value>0.5</value></alpha>
        </color>
        <size>
          <value>0.15</value>
        </size>
      </start>
      <end>
        <color>
          <red><value>0.95</value></red>
          <green><value>0.95</value></green>
          <blue><value>0.95</value></blue>
          <alpha><value>0.001</value></alpha>
        </color>
        <size>
          <value>3.5</value>
        </size>
      </end>
      
      <life-sec>
        <value>1.8</value>
      </life-sec>
      
      <mass-kg>0.001</mass-kg>
      <radius-m>0.12</radius-m>
    </particle>
    
    <program>
      <fluid>air</fluid>
      <gravity>false</gravity>
      <wind>true</wind>
    </program>
  </particlesystem>

</PropertyList>

