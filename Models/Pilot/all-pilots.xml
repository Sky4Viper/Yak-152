<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <model>
    <name>ThePilot</name>
    <path>pilotlowpoly.xml</path>
    <offsets>
      <x-m> -0.47 </x-m>
      <y-m>  0.000 </y-m>
      <z-m> -0.165 </z-m>
    </offsets>
  </model>

  <!-- Updated Pilot Animation: Tracks individual front seat ejection -->
  <animation>
    <type>select</type>
    <object-name>ThePilot</object-name>
    <condition>
      <and>
        <not-equals>
          <property>sim/current-view/name</property>
          <value>Cockpit View</value>
        </not-equals>
        <not><property>/controls/seat/eject[0]/ejected</property></not>
      </and>
    </condition>
  </animation>

  <model>
    <name>Copilot</name>
    <path>pilotlowpoly.xml</path>
    <offsets>
      <x-m>  0.8335 </x-m>
      <y-m>  0.000 </y-m>
      <z-m> -0.185 </z-m>
    </offsets>
  </model>

  <!-- Updated Copilot Animation: Tracks individual rear seat ejection -->
  <animation>
    <type>select</type>
    <object-name>Copilot</object-name>
    <condition>
      <and>
        <property>sim/multiplay/generic/bool[0]</property>
        <not-equals>
          <property>sim/current-view/name</property>
          <value>Instructor Seat View</value>
        </not-equals>
        <not><property>/controls/seat/eject[1]/ejected</property></not>
      </and>
    </condition>
  </animation>

  <animation>
    <type>translate</type>
    <object-name>ThePilot</object-name>
    <property>/controls/seat/eject[0]/eject-norm</property>
    <interpolation>
      <entry><ind> 0 </ind><dep> 0 </dep></entry>
      <entry><ind> 0.6 </ind><dep> 0.8 </dep></entry>
    </interpolation>
    <axis>
      <x1-m> -0.320835 </x1-m>
      <y1-m>  0.00000 </y1-m>
      <z1-m> -0.239949 </z1-m>
      <x2-m> -0.135893 </x2-m>
      <y2-m>  0.00000 </y2-m>
      <z2-m>  0.379578  </z2-m>
    </axis>
  </animation>

  <animation>
    <type>translate</type>
    <object-name>Copilot</object-name>
    <property>/controls/seat/eject[1]/eject-norm</property>
    <interpolation>
      <entry><ind> 0 </ind><dep> 0 </dep></entry>
      <entry><ind> 0.6 </ind><dep> 0.8 </dep></entry>
    </interpolation>
    <axis>
      <x1-m> -0.320835 </x1-m>
      <y1-m>  0.00000 </y1-m>
      <z1-m> -0.239949 </z1-m>
      <x2-m> -0.135893 </x2-m>
      <y2-m>  0.00000 </y2-m>
      <z2-m>  0.379578  </z2-m>
    </axis>
  </animation>

</PropertyList>
