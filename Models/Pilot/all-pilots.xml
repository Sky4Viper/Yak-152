<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <model>
    <name>ThePilot</name>
    <path>pilotlowpoly.xml</path>
    <offsets>
      <x-m> -0.47 </x-m>
      <y-m>  0.000 </y-m>
      <z-m> -0.165 </z-m>
    </offsets>
  </model>

  <!-- Updated Pilot Animation: Tracks individual front seat ejection -->
  <animation>
    <type>select</type>
    <object-name>ThePilot</object-name>
    <condition>
      <and>
        <not-equals>
          <property>sim/current-view/name</property>
          <value>Cockpit View</value>
        </not-equals>
        <not><property>/controls/seat/eject/pilot-ejected</property></not>
      </and>
    </condition>
  </animation>

  <model>
    <name>Copilot</name>
    <path>pilotlowpoly.xml</path>
    <offsets>
      <x-m>  0.8335 </x-m>
      <y-m>  0.000 </y-m>
      <z-m> -0.185 </z-m>
    </offsets>
  </model>

  <!-- Updated Copilot Animation: Tracks individual rear seat ejection -->
  <animation>
    <type>select</type>
    <object-name>Copilot</object-name>
    <condition>
      <and>
        <property>sim/multiplay/generic/bool[0]</property>
        <not-equals>
          <property>sim/current-view/name</property>
          <value>Instructor Seat View</value>
        </not-equals>
        <not><property>/controls/seat/eject/copilot-ejected</property></not>
      </and>
    </condition>
  </animation>

</PropertyList>
