  <!-- Propeller -->
  <animation>
    <name>Helice</name>
    <object-name>pale1</object-name>
    <object-name>pale2</object-name>
    <object-name>pale3</object-name>
  </animation>

  <animation>
    <name>HeliceComplete</name>
    <object-name>propdisc</object-name>
    <object-name>propblur</object-name>
    <object-name>Helice</object-name>
    <object-name>nosecone</object-name>
  </animation>

  <!-- Selection of visible objects by rpm -->
  <animation>
    <type>select</type>
    <object-name>propdisc</object-name>
    <condition>
      <greater-than>
        <property>engines/engine[0]/rpm</property>
        <value>800</value>
      </greater-than>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>propblur</object-name>
    <condition>
    <and>
      <greater-than>
        <property>engines/engine[0]/rpm</property>
        <value>300.000</value>
      </greater-than>
      <less-than>
        <property>engines/engine[0]/rpm</property>
        <value>800.001</value>
      </less-than>
    </and>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>Helice</object-name>
    <condition>
      <less-than>
        <property>engines/engine[0]/rpm</property>
        <value>800</value>
      </less-than>
    </condition>
  </animation>

  <animation>
    <type>spin</type>
    <object-name>HeliceComplete</object-name>
    <condition>
      <!-- <not><property>controls/engines/engine[0]/cutoff</property></not> -->
      <!-- <not><property>sim/multiplay/generic/bool[6]</property></not> -->
      <greater-than>
        <property>engines/engine[0]/rpm</property>
        <value> 5 </value>
      </greater-than>
    </condition>
    <!-- <property>engines/engine[0]/rpm</property> -->
    <property>sim/multiplay/generic/float[4]</property>
    <factor> 1 </factor>
    <center>
      <x-m> -2.92350 </x-m>
      <y-m>  0.00000 </y-m>
      <z-m> -0.11897 </z-m>
    </center>
    <axis>
      <x>-1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <!-- Gouverne de rudder -->
  <animation>
    <type>rotate</type>
    <object-name>rudder</object-name>
    <!-- <property>controls/flight/rudder</property> -->
    <property>surface-positions/rudder-pos-norm</property>
    <factor> 15 </factor>
    <axis>
      <x1-m> 3.15725 </x1-m>
      <y1-m> 0.00000 </y1-m>
      <z1-m>-0.30144 </z1-m>
      <x2-m> 3.15725 </x2-m>
      <y2-m> 0.00000 </y2-m>
      <z2-m> 1.13587 </z2-m>
    </axis>
  </animation>

