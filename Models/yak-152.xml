    <object-name>phareD</object-name>
    <object-name>propblur</object-name>
    <object-name>propdisc</object-name>
  </effect>

  <animation>
    <object-name>glass_cracked.001</object-name>
    <object-name>glass_cracked.002</object-name>
    <render-bin>
      <bin-name>TransparentBin</bin-name>
      <bin-number>11</bin-number>
    </render-bin>
  </animation>

  <!-- working for Compositor -->
  <effect>
    <inherits-from>Effects/Glass/glassrain</inherits-from>
    <object-name>canopy_glass.001</object-name>
    <object-name>canopy_glass.002</object-name>
  </effect>

  <effect>
    <inherits-from>Effects/Glass/glass</inherits-from>
    <object-name>HDRcanopy_glass.001</object-name>
    <object-name>HDRcanopy_glass.002</object-name>
  </effect>

  <!-- Select HDR glass -->
  <animation>
    <type>select</type>
    <condition>
      <!-- <property>sim/rendering/hdr/hdr-enabled</property> -->
      <property>sim/multiplay/generic/bool[2]</property>
    </condition>
    <object-name>HDRcanopy_glass.001</object-name>
    <object-name>HDRcanopy_glass.002</object-name>
  </animation>

  <animation>
    <type>select</type>
    <condition>
      <!-- <not><property>sim/rendering/hdr/hdr-enabled</property></not> -->
      <not><property>sim/multiplay/generic/bool[2]</property></not>
    </condition>
    <object-name>canopy_glass.001</object-name>
    <object-name>canopy_glass.002</object-name>
  </animation>

  <model>
    <path>Interior/interior.xml</path>
  </model>

  <model>
    <path>light/all-lights.xml</path>
  </model>

  <model>
    <path>Effects/cranking/all-crankings.xml</path>
