<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>yak-152.ac</path>

  <!-- MP sound call -->
  <sound>
    <path>Aircraft/Yak-152/Sounds/mp-sound.xml</path>
  </sound>

  <nasal>
    <load>
      var livery_update = aircraft.livery_update.new("Aircraft/Yak-152/Models/Liveries", 10);
    </load>
    <unload>
      livery_update.stop();
    </unload>
  </nasal>

  <animation>
    <!-- Objets opaques -->
    <object-name>fuselage</object-name>
    <object-name>wing</object-name>
    <object-name>rudder</object-name>
    <object-name>tail</object-name>
    <object-name>elevator</object-name>
    <object-name>canopy_frame</object-name>
    <object-name>internals</object-name>
    <object-name>gill</object-name>
    <object-name>exhaust_base</object-name>

    <object-name>gear_door_L</object-name>
    <object-name>gear_door_R</object-name>

    <object-name>aileron_L</object-name>
    <object-name>aileron_R</object-name>
    <object-name>flap_L</object-name>
    <object-name>flap_R</object-name>

    <object-name>antena</object-name>
    <object-name>pitot</object-name>
    <object-name>nosecone</object-name>

    <object-name>light_base</object-name>
    <object-name>wing_light</object-name>
    

    <!-- Objets transparents -->
    <object-name>canopy_glass.001</object-name>
    <object-name>canopy_glass.002</object-name>
    <object-name>light_dome</object-name>
    <object-name>propblur</object-name>
    <object-name>propdisc</object-name>
    <object-name>wing_light_glass</object-name>
    <object-name>glass_cracked.001</object-name>
    <object-name>glass_cracked.002</object-name>
    
    <!-- HDR mode -->
    <object-name>HDRcanopy_glass.001</object-name>
    <object-name>HDRcanopy_glass.002</object-name>
  </animation>

  <animation>
    <type>material</type>
    <object-name>fuselage</object-name>
    <object-name>wing</object-name>
    <object-name>rudder</object-name>
    <object-name>tail</object-name>
    <object-name>elevator</object-name>
    <object-name>canopy_frame</object-name>
    <object-name>internals</object-name>
    <object-name>gill</object-name>
    <object-name>exhaust_base</object-name>

    <object-name>gear_door_L</object-name>
    <object-name>gear_door_R</object-name>

    <object-name>aileron_L</object-name>
    <object-name>aileron_R</object-name>
    <object-name>flap_L</object-name>
    <object-name>flap_R</object-name>

    <object-name>antena</object-name>
    <object-name>pitot</object-name>
    <object-name>nosecone</object-name>

    <object-name>light_base</object-name>
    <object-name>light_dome</object-name>
    <object-name>light_dome.001</object-name>
    <object-name>gear_light_base</object-name>
    <object-name>gear_light_dome</object-name>
    <object-name>wing_light</object-name>
    <object-name>wing_light_glass</object-name>

    <property-base>sim/model/livery</property-base>
    <texture-prop>texture</texture-prop>
    <texture>texture.png</texture>
    <specular>
      <red-prop>specular/red</red-prop>
      <green-prop>specular/green</green-prop>
      <blue-prop>specular/blue</blue-prop>
    </specular>
  </animation>

  <effect>
    <inherits-from>Aircraft/Yak-152/Models/Effects/Bump/bumpspec</inherits-from>
    <object-name>fuselage</object-name>
    <object-name>wing</object-name>
    <object-name>rudder</object-name>
    <object-name>tail</object-name>
    <object-name>elevator</object-name>
    <object-name>canopy_frame</object-name>
    <object-name>gill</object-name>
    <object-name>exhaust_base</object-name>

    <object-name>gear_door_L</object-name>
    <object-name>gear_door_R</object-name>

    <object-name>aileron_L</object-name>
    <object-name>aileron_R</object-name>
    <object-name>flap_L</object-name>
    <object-name>flap_R</object-name>

    <object-name>antena</object-name>
    <object-name>pitot</object-name>
    <object-name>nosecone</object-name>

  </effect>

  <effect>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>lampeR</object-name>
    <object-name>lampeG</object-name>
