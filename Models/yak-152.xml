  <!-- Canopy -->
  <animation>
    <name>CanopyComplete</name>
    <object-name>canopy_frame</object-name>
    <object-name>canopy_glass.001</object-name>
    <object-name>canopy_glass.002</object-name>
  </animation>

  <animation>
    <type>pick</type>
    <object-name>CanopyComplete</object-name>
    <object-name>HDRcanopy_glass.001</object-name>
    <object-name>HDRcanopy_glass.002</object-name>
    <visible>true</visible>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <condition>
          <and>
            <property>gear/gear[0]/wow</property>
            <property>gear/gear[1]/wow</property>
            <property>gear/gear[2]/wow</property>
            <less-than>
              <property>gear/gear[0]/rollspeed-ms</property>
              <value>10</value>
            </less-than>
          </and>
        </condition>
        <command>nasal</command>
        <script>doors.crew.toggle();</script>
      </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>CanopyComplete</object-name>
    <object-name>HDRcanopy_glass.001</object-name>
    <object-name>HDRcanopy_glass.002</object-name>
    <object-name>glass_cracked.001</object-name>
    <object-name>glass_cracked.002</object-name>
    <!-- <property>sim/model/door-positions/crew/position-norm</property> -->
    <property>sim/multiplay/generic/float[0]</property>
    <factor> -95 </factor>
    <axis>
      <x1-m> -0.80849 </x1-m>
      <y1-m>  0.39471 </y1-m>
      <z1-m>  0.09252 </z1-m>
      <x2-m>  0.86179 </x2-m>
      <y2-m>  0.38590 </y2-m>
      <z2-m>  0.14012 </z2-m>
    </axis>
  </animation>

  <animation>
    <type>select</type>
    <object-name>canopy_glass.001</object-name>
    <object-name>HDRcanopy_glass.001</object-name>
    <condition>
      <not><property>/controls/seat/eject/pilot-ejected</property></not>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>canopy_glass.002</object-name>
    <object-name>HDRcanopy_glass.002</object-name>
    <condition>
      <not><property>/controls/seat/eject/copilot-ejected</property></not>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>glass_cracked.001</object-name>
    <!-- <condition>
      <property>/controls/seat/eject/pilot-ejected</property>
    </condition> -->
    <condition>
			<greater-than>
				<property>/controls/seat/eject/eject-norm</property>
				<value>0.95</value>
			</greater-than>
		</condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>glass_cracked.002</object-name>
    <condition>
			<greater-than>
				<property>/controls/seat/eject/eject-norm</property>
				<value>0.8</value>
			</greater-than>
      <property>/controls/seat/eject/copilot-ejected</property>
		</condition>
  </animation>

